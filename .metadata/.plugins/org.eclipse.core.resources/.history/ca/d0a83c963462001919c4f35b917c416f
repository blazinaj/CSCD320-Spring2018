	// A Node Class
	class Node {
		int key;
		char value;
		Node left, right;
		
		public Node(int item, char letter) {
			key = item;
			value = letter;
		}
	}
		
	// The Root node
	Node root;
	
	//Initial Constructor
	Main(){
		root = null;
	}
	
	void insert(int key, char value) {
		root = insertRecursively(root, key, value);
	}
	
	Node insertRecursively(Node root, int key, char value) {
		// if tree is empty, return new node
		if (root == null) {
			root = new Node(key, value);
			return root;
		}
		
		// if tree is not empty, recurse down the tree
		if (key < root.key) {
			root.left = insertRecursively(root.left, key, value);
		}
		else if (key > root.key) {
			root.right = insertRecursively(root.right, key, value);
		}
		
		return root;
	}
	
	// In order Traversal
	void inOrder() {
		inOrderRecursively(root);
		System.out.println();
	}
	
	// Recursive helper for In Order Traversal.
	void inOrderRecursively(Node root) {
		if (root != null) {
			inOrderRecursively(root.left);
			System.out.print(root.value);
			inOrderRecursively(root.right);
		}
	}
	
	// Pre Order Traversal
	void preOrder() {
		preOrderRecursively(root);
		System.out.println();
	}
	
	// Recursive helper for Pre Order Traversal
	void preOrderRecursively(Node root) {
		if (root != null) {
			System.out.print(root.value);
			preOrderRecursively(root.left);
			preOrderRecursively(root.right);
		}
	}
	
	// Pre Order Traversal
	void postOrder() {
		postOrderRecursively(root);
		System.out.println();
	}
	
	// Recursive helper for Pre Order Traversal
	void postOrderRecursively(Node root) {
		if (root != null) {
			postOrderRecursively(root.left);
			postOrderRecursively(root.right);
			System.out.print(root.value);
		}
	}
	
	// Delete a node by key
	void deleteNode(int key) {
		root = deleteRecursively(root, key);
	}
	
	// Recursive helper for Deletion
	Node deleteRecursively(Node root, int key) {
		// tree is empty
		if (root == null)
			return root;
		
		// recurse down the tree
		if (key < root.key) {
			root.left = deleteRecursively(root.left, key);
		}
		else if (key > root.key) {
			root.right = deleteRecursively(root.right, key);
		}
		// found the key
		else {
			// zero or one child
			if (root.left == null) {
				return root.right;
			}
			else if (root.right == null) {
				return root.left;
			}
			
			// two children
			root.key = smallestValue(root.right);
			
			root.right = deleteRecursively(root.right, root.key);
		}
		return root;
	}
	
	int smallestValue(Node root) {
		int small = root.key;
		while (root.left != null) {
			small = root.left.key;
			root = root.left;
		}
		return small;
	}
