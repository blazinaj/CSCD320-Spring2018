	// A Node Class
	class Node {
		int key;
		char value;
		Node left, right;
		
		public Node(int item, char letter) {
			key = item;
			value = letter;
		}
	}
		
		// The Root node
		Node root;
		
		//Initial Constructor
		Main(){
			root = null;
		}
		
		void insert(int key, char value) {
			root = insertRecursively(root, key, value);
		}
		
		Node insertRecursively(Node root, int key, char value) {
			// if tree is empty, return new node
			if (root == null) {
				root = new Node(key, value);
				return root;
			}
			
			// if tree is not empty, recurse down the tree
			if (key < root.key) {
				root.left = insertRecursively(root.left, key, value);
			}
			else if (key > root.key) {
				root.right = insertRecursively(root.right, key, value);
			}
			
			return root;
		}
		
		// In order Traversal
		void inOrder() {
			inOrderRecursively(root);
		}
		
		// Recursive helper for In Order Traversal.
		void inOrderRecursively(Node root) {
			if (root != null) {
				inOrderRecursively(root.left);
				System.out.println(root.value);
				inOrderRecursively(root.right);
			}
		}
	}

}
